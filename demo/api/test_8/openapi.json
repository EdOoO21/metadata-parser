{
  "openapi": "3.0.0",
  "info": {
    "title": "Demo API Case 10",
    "version": "1.0.0"
  },
  "paths": {
    "/customers": {
      "get": {
        "summary": "Customers collection",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "full_name"],
                    "properties": {
                      "id": { "type": "integer" },
                      "full_name": { "type": "string" },
                      "segment": { "type": "string", "nullable": true }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "summary": "Customer by id",
        "description": "Path parameter endpoint",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "full_name"],
                  "properties": {
                    "id": { "type": "integer" },
                    "full_name": { "type": "string" },
                    "email": { "type": "string", "nullable": true },
                    "phone": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/customers/{id}/tickets": {
      "get": {
        "summary": "Customer tickets",
        "description": "Nested path parameter endpoint",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "status", "opened_at"],
                    "properties": {
                      "id": { "type": "integer" },
                      "status": { "type": "string" },
                      "opened_at": { "type": "string" },
                      "closed_at": { "type": "string", "nullable": true }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tickets": {
      "get": {
        "summary": "Tickets collection",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "title", "priority", "status"],
                    "properties": {
                      "id": { "type": "integer" },
                      "title": { "type": "string" },
                      "priority": { "type": "string" },
                      "status": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{ticket_id}": {
      "get": {
        "summary": "Ticket by id",
        "description": "Path parameter endpoint",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "title", "priority", "status"],
                  "properties": {
                    "id": { "type": "integer" },
                    "title": { "type": "string" },
                    "priority": { "type": "string" },
                    "status": { "type": "string" },
                    "requester_email": { "type": "string", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
