{
  "openapi": "3.0.0",
  "info": {
    "title": "API diff case 1 baseline",
    "version": "1.0.0"
  },
  "paths": {
    "/users": {
      "get": {
        "summary": "Users",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "name", "active", "created_at"],
                    "properties": {
                      "id": { "type": "integer" },
                      "name": { "type": "string" },
                      "active": { "type": "boolean" },
                      "created_at": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "summary": "Orders",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "user_id", "amount", "status"],
                    "properties": {
                      "id": { "type": "integer" },
                      "user_id": { "type": "integer" },
                      "amount": { "type": "number" },
                      "status": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
