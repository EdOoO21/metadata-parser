{
  "openapi": "3.0.0",
  "info": {
    "title": "API diff case 2 baseline",
    "version": "1.0.0"
  },
  "paths": {
    "/products": {
      "get": {
        "summary": "Products",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["sku", "name", "price", "active"],
                    "properties": {
                      "sku": { "type": "string" },
                      "name": { "type": "string" },
                      "price": { "type": "number" },
                      "active": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/payments": {
      "get": {
        "summary": "Payments",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["payment_id", "order_id", "amount", "method"],
                    "properties": {
                      "payment_id": { "type": "integer" },
                      "order_id": { "type": "integer" },
                      "amount": { "type": "number" },
                      "method": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "uptime_seconds"],
                  "properties": {
                    "status": { "type": "string" },
                    "uptime_seconds": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
