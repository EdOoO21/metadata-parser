{
  "openapi": "3.0.0",
  "info": {
    "title": "Demo API Case 5",
    "version": "1.0.0"
  },
  "paths": {
    "/summary": {
      "get": {
        "summary": "Summary",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["service", "version", "requests_total"],
                  "properties": {
                    "service": { "type": "string" },
                    "version": { "type": "string" },
                    "requests_total": { "type": "integer" },
                    "generated_at": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "summary": "Tasks",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "title", "done"],
                    "properties": {
                      "id": { "type": "integer" },
                      "title": { "type": "string" },
                      "done": { "type": "boolean" },
                      "assignee": { "type": "string", "nullable": true }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "checked_at"],
                  "properties": {
                    "status": { "type": "string" },
                    "checked_at": { "type": "string" },
                    "degraded": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
