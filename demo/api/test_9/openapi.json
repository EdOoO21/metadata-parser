{
  "openapi": "3.0.3",
  "info": {
    "title": "All Methods Demo API",
    "version": "1.0.0"
  },
  "paths": {
    "/items": {
      "get": {
        "tags": ["items"],
        "summary": "List items",
        "operationId": "listItems",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Item" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["items"],
        "summary": "Create item",
        "operationId": "createItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ItemCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created item",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          }
        }
      }
    },
    "/items/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "integer" }
        }
      ],
      "get": {
        "tags": ["items"],
        "summary": "Get item",
        "operationId": "getItem",
        "responses": {
          "200": {
            "description": "Item",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["items"],
        "summary": "Replace item",
        "operationId": "replaceItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ItemCreateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated item",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["items"],
        "summary": "Patch item",
        "operationId": "patchItem",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ItemPatchRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Patched item",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["items"],
        "summary": "Delete item",
        "operationId": "deleteItem",
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      },
      "head": {
        "tags": ["items"],
        "summary": "Check item",
        "operationId": "headItem",
        "responses": {
          "200": {
            "description": "Exists"
          }
        }
      },
      "options": {
        "tags": ["items"],
        "summary": "Allowed item methods",
        "operationId": "optionsItem",
        "responses": {
          "200": {
            "description": "Allowed methods"
          }
        }
      },
      "trace": {
        "tags": ["items"],
        "summary": "Trace item",
        "operationId": "traceItem",
        "responses": {
          "200": {
            "description": "Trace response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "active": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "ItemCreateRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "active": { "type": "boolean" }
        }
      },
      "ItemPatchRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "active": { "type": "boolean" }
        }
      }
    }
  }
}
